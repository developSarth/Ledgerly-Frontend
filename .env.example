# Supabase — use the project URL and anon/publishable key only.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# OpenAI — GPT-5.4 mini is used for optional LLM-assisted header mapping,
# reply classification, and draft suggestions. Never put this key in Vite vars.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
AI_FEATURES_ENABLED=false

# Gmail API OAuth — Google Cloud OAuth Web application credentials.
# The callback URI must exactly match the URI registered in Google Cloud.
# Gmail OAuth routes are not enabled yet; see backend/README.md.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/gmail/callback
GMAIL_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send openid email
GMAIL_PUBSUB_TOPIC=
GMAIL_FEATURES_ENABLED=false

# Runtime safety. Keep outbound email disabled until Gmail integration,
# firm approval checks, and production controls are implemented and reviewed.
EMAIL_SEND_ENABLED=false
